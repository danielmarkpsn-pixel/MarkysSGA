# Copie para .env e substitua todos os valores de exemplo antes de iniciar.
# Nunca publique o arquivo .env real.
APP_PORT=8080
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_LONGO

POSTGRES_VERSION=16
POSTGRES_DB=markys
POSTGRES_USER=markys
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_FORTE_ALFANUMERICA

# A senha no DATABASE_URL deve corresponder a POSTGRES_PASSWORD.
DATABASE_URL=postgresql://markys:SUBSTITUA_POR_SENHA_FORTE_ALFANUMERICA@database:5432/markys?serverVersion=16&charset=utf8

# Segredo JWT do Mercure; use um valor longo e exclusivo.
MERCURE_JWT_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_LONGO
MERCURE_PUBLIC_URL=http://localhost:8080/.well-known/mercure
