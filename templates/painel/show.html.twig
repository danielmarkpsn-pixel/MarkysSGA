{%- extends 'skeleton.html.twig' -%}

{% block title %}Painel{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/painel.css') }}&t={{ 'now'|date('U') }}">
<style>
:root {
    {% if settings.corFundoDestaque %}--bg-featured: {{ settings.corFundoDestaque }};{% endif %}
    {% if settings.corFundoRodape %}--bg-footer: {{ settings.corFundoRodape }};{% endif %}
    {% if settings.corFundoHistorico %}--bg-history: {{ settings.corFundoHistorico }};{% endif %}
    {% if settings.corFundoRelogio %}--bg-clock: {{ settings.corFundoRelogio }};{% endif %}
}
</style>
{% endblock %}

{% block body_content %}
<div id="app"
    data-mercure-url="{{ mercureUrl }}",
    data-base-url="{{ path('painel_show', { publicId: painel.publicId}) }}"
    data-public-id="{{ painel.publicId }}"
    data-unidade-id="{{ painel.unidade.id }}">
    <div id="painel">
        <div id="featured" :class="{ flash: isFlash }">
            <div id="featured-inner" :class="{ 'ticket-enter': ticketEnter }" v-show="featured">
                <div id="featured-label">Senha chamada</div>
                <div id="featured-title"
                     :class="{ priority: featuredIsPriority }"
                     :style="{ '--featured-color': featured?.corPrioridade || '#000' }"
                     v-text="featuredTitle"></div>
                <div id="featured-subtitle" v-text="featuredSubtitle"></div>
                <div id="featured-description" v-text="featuredDescription"></div>
            </div>
            <div id="featured-empty" v-show="!featured">Aguardando chamada&hellip;</div>

            <footer id="featured-footer">
                {% if settings.logo %}
                    <img id="markys-logo" src="{{ settings.logo }}" alt="Logo">
                {% else %}
                    <img id="markys-logo" src="{{ asset('images/markys-login.svg') }}" alt="MARKYS SGA">
                {% endif %}
                
            </footer>
        </div>

        <aside id="sidebar">
            <div id="history">
                <div id="history-heading">Histórico</div>
                <div v-if="history.length === 0" id="history-empty">sem registros</div>
                <div v-for="t in history"
                     :key="t.id"
                     class="history-item"
                     :class="{ priority: (t.peso || 0) > 0 }"
                     :style="{ '--history-item-color': t.corPrioridade || '#000' }">
                    <div class="hi-ticket" v-text="t.senha"></div>
                    <div class="hi-desk" v-text="t.local + ' ' + padNum(t.numeroLocal, 2)"></div>
                    <div class="hi-service" v-text="t.servico ? t.servico.nome : ''"></div>
                </div>
            </div>
            <div id="clock-box">
                <div id="clock-time" v-text="clockTime"></div>
                <div id="clock-date" v-text="clockDate"></div>
            </div>
        </aside>

    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/vue.min.js') }}"></script>
<script src="{{ asset('js/painel.js') }}"></script>
{% endblock %}
